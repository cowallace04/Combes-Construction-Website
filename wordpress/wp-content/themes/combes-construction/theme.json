{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "name": "Primary Blue",
          "slug": "primary-blue",
          "color": "#014E8B"
        },
        {
          "name": "Secondary Blue",
          "slug": "secondary-blue",
          "color": "#1F4D9E"
        },
        {
          "name": "Accent Blue",
          "slug": "accent-blue",
          "color": "#346FA2"
        },
        {
          "name": "Soft Blue",
          "slug": "soft-blue",
          "color": "#AEC5D7"
        },
        {
          "name": "Link Blue",
          "slug": "link-blue",
          "color": "#79B8E8"
        },
        {
          "name": "Base Background",
          "slug": "base-background",
          "color": "#050814"
        },
        {
          "name": "Section Background",
          "slug": "section-background",
          "color": "#082745"
        },
        {
          "name": "Card Surface",
          "slug": "card-surface",
          "color": "#111827"
        },
        {
          "name": "Alternate Surface",
          "slug": "alternate-surface",
          "color": "#1F2933"
        },
        {
          "name": "Primary Text",
          "slug": "primary-text",
          "color": "#F9FAFB"
        },
        {
          "name": "Muted Text",
          "slug": "muted-text",
          "color": "#D0D2D4"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#FFFFFF"
        },
        {
          "name": "Warning",
          "slug": "warning",
          "color": "#FACC15"
        }
      ]
    },
    "layout": {
      "contentSize": "768px",
      "wideSize": "1248px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "name": "Extra Small",
          "slug": "10",
          "size": "0.5rem"
        },
        {
          "name": "Small",
          "slug": "20",
          "size": "1rem"
        },
        {
          "name": "Medium",
          "slug": "30",
          "size": "1.5rem"
        },
        {
          "name": "Large",
          "slug": "40",
          "size": "2rem"
        },
        {
          "name": "Extra Large",
          "slug": "50",
          "size": "3rem"
        },
        {
          "name": "Section",
          "slug": "60",
          "size": "6rem"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Barlow",
          "slug": "barlow",
          "fontFamily": "\"Barlow\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "name": "Source Sans 3",
          "slug": "source-sans-3",
          "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Body",
          "slug": "body",
          "size": "1rem"
        },
        {
          "name": "Lead",
          "slug": "lead",
          "size": "1.25rem"
        },
        {
          "name": "Heading 3",
          "slug": "heading-3",
          "size": "1.75rem"
        },
        {
          "name": "Heading 2",
          "slug": "heading-2",
          "size": "clamp(2rem, 4vw, 3.75rem)"
        },
        {
          "name": "Display",
          "slug": "display",
          "size": "clamp(2.75rem, 6vw, 5.5rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base-background",
      "text": "var:preset|color|primary-text"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|source-sans-3",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var:preset|color|primary-blue",
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|barlow",
          "fontWeight": "600"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|primary-text"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|barlow",
          "fontWeight": "600",
          "lineHeight": "1.15"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|link-blue"
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ]
}